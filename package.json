{
  "name": "@tago-io/decoders",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "linter": "oxlint --type-aware .",
    "lint:fix": "oxlint --type-aware . --fix",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt --write .",
    "check": "oxlint --type-aware . && oxfmt --check .",
    "typecheck": "tsc --noEmit",
    "ci": "pnpm run check && pnpm run typecheck && pnpm test && pnpm start validator",
    "start": "node --env-file=.env src/main.ts"
  },
  "devDependencies": {
    "@swc/core": "catalog:",
    "@tago-io/sdk": "catalog:",
    "@types/node": "catalog:",
    "@types/validator": "catalog:",
    "ajv": "catalog:",
    "ajv-formats": "catalog:",
    "better-sqlite3": "catalog:",
    "knex": "catalog:",
    "moment-timezone": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "sqlite3": "catalog:",
    "typescript": "catalog:",
    "uuid": "catalog:",
    "validator": "catalog:",
    "vitest": "catalog:",
    "vm2": "catalog:",
    "zod": "catalog:"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=11.5.0"
  },
  "packageManager": "pnpm@11.5.0"
}
